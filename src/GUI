<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>GonioPro // Home Care Analytics</title>
   <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
   <script src="https://cdn.tailwindcss.com"></script>
   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
   <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
   <style>
       :root {
           --bg: #f8fafc;
           --accent: #0f172a;
           --brand: #6366f1;
           --success: #10b981;
           --warning: #f59e0b;
       }


       body {
           font-family: 'Space Grotesk', sans-serif;
           background-color: var(--bg);
           color: var(--accent);
       }


       .mono { font-family: 'JetBrains Mono', monospace; }


       .neo-card {
           background: white;
           border: 2px solid var(--accent);
           box-shadow: 4px 4px 0px var(--accent);
       }


       .btn-primary {
           background: var(--brand);
           color: white;
           border: 2px solid var(--accent);
           box-shadow: 3px 3px 0px var(--accent);
           font-weight: 700;
           transition: all 0.1s;
       }


       .btn-primary:active { transform: translate(2px, 2px); box-shadow: 0px 0px 0px; }


       .btn-danger {
           background: #ef4444;
           color: white;
           border: 2px solid var(--accent);
           box-shadow: 3px 3px 0px var(--accent);
           font-weight: 700;
       }


       .btn-outline {
           border: 2px solid var(--accent);
           background: white;
           padding: 8px 16px;
           font-weight: 700;
           text-transform: uppercase;
           font-size: 12px;
           cursor: pointer;
       }


       .pain-btn {
           border: 2px solid var(--accent);
           transition: all 0.2s;
       }
       .pain-selected {
           background: var(--brand);
           color: white;
           transform: scale(1.1);
       }


       #visualizer-container {
           height: 420px;
           background: #eef2f7;
           border: 2px solid var(--accent);
           position: relative;
       }


       .tab-btn.active {
           background: var(--accent);
           color: white;
       }


       input[type=range] { -webkit-appearance: none; background: transparent; }
       input[type=range]::-webkit-slider-runnable-track { height: 8px; background: #e2e8f0; border: 1px solid var(--accent); border-radius: 4px; }
       input[type=range]::-webkit-slider-thumb { border: 2px solid var(--accent); height: 20px; width: 20px; background: var(--brand); -webkit-appearance: none; margin-top: -7px; border-radius: 50%; }
      
       .hold-active {
           animation: pulse-indigo 1s infinite;
       }
       @keyframes pulse-indigo {
           0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); }
           70% { box-shadow: 0 0 0 10px rgba(99, 102, 241, 0); }
           100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
       }

       .rep-flash {
           animation: rep-success 0.85s ease-out;
       }

       @keyframes rep-success {
           0% { background: #10b981; color: white; transform: scale(1); }
           35% { background: #34d399; color: white; transform: scale(1.08); }
           100% { background: white; color: var(--accent); transform: scale(1); }
       }


       #surveyModal {
           backdrop-filter: blur(4px);
           transition: opacity 0.3s ease;
       }
       .modal-content {
           transform: translateY(20px);
           transition: transform 0.3s ease;
       }
       #surveyModal.active .modal-content {
           transform: translateY(0);
       }
   </style>
</head>
<body class="p-4 md:p-6 lg:p-8">


   <!-- Post-Session Home Care Survey Modal -->
   <div id="surveyModal" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4">
       <div class="modal-content neo-card bg-white w-full max-w-2xl p-8 max-h-[90vh] overflow-y-auto">
           <div class="flex justify-between items-start mb-6">
               <div>
                   <h2 class="text-3xl font-bold uppercase tracking-tighter">Session Recovery Log</h2>
                   <p class="mono text-xs opacity-60">PATIENT HOME-CARE PORTAL V.2.6</p>
               </div>
               <div class="bg-black text-[#00ff00] px-3 py-1 mono text-xs font-bold" id="finalRepCount">REPS: 0</div>
           </div>


           <form id="sessionSurveyForm" class="space-y-6">
               <div class="space-y-4">
                   <h3 class="font-bold border-b-2 border-slate-900 pb-1 text-sm uppercase">At-Home Self Assessment</h3>
                  
                   <!-- Pain Threshold Metric -->
                   <div class="space-y-2">
                       <label class="mono text-[11px] font-bold uppercase flex justify-between">
                           <span>Joint Discomfort (0-10):</span>
                           <span id="painValModal" class="text-indigo-600 font-bold">0</span>
                       </label>
                       <input type="range" id="surveyPain" min="0" max="10" value="0" class="w-full" oninput="document.getElementById('painValModal').innerText=this.value">
                       <p class="text-[9px] opacity-60 italic uppercase font-bold">Did you feel sharp pain when reaching the target?</p>
                   </div>


                   <!-- Functional Ease Metric -->
                   <div class="space-y-2">
                       <label class="mono text-[11px] font-bold uppercase flex justify-between">
                           <span>Ease of Movement:</span>
                           <span id="easeVal" class="text-indigo-600 font-bold">Fluid</span>
                       </label>
                       <input type="range" id="surveyEase" min="1" max="3" value="3" class="w-full" oninput="const labels=['Stiff','Moderate','Fluid']; document.getElementById('easeVal').innerText=labels[this.value-1]">
                       <p class="text-[9px] opacity-60 italic uppercase font-bold">How did the joint feel during the reps?</p>
                   </div>


                   <!-- Setup & Safety -->
                   <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                       <div class="space-y-2">
                           <label class="mono text-[11px] font-bold uppercase">Setup Difficulty:</label>
                           <select id="surveySetup" class="w-full border-2 border-slate-900 p-2 mono text-xs outline-none focus:bg-indigo-50">
                               <option value="easy">EASY (NO HELP)</option>
                               <option value="assisted">NEEDED ASSISTANCE</option>
                               <option value="difficult">HARD TO STRAP ON</option>
                           </select>
                       </div>
                       <div class="space-y-2">
                           <label class="mono text-[11px] font-bold uppercase">Confidence Level:</label>
                           <select id="surveyConfidence" class="w-full border-2 border-slate-900 p-2 mono text-xs outline-none focus:bg-indigo-50">
                               <option value="high" selected>FEELING PROGRESS</option>
                               <option value="neutral">STABLE / NO CHANGE</option>
                               <option value="low">FEELING WEAKNESS</option>
                           </select>
                       </div>
                   </div>
               </div>


               <div class="space-y-2">
                   <h3 class="font-bold border-b-2 border-slate-900 pb-1 text-sm uppercase">Message for Physical Therapist</h3>
                   <textarea id="surveyComments" placeholder="Note any clicking, swelling, or unusual sensations..." class="w-full border-2 border-slate-900 p-3 mono text-xs h-24 outline-none focus:bg-indigo-50 resize-none"></textarea>
               </div>


               <div class="flex gap-4 pt-4">
                   <button type="button" onclick="closeSurvey()" class="flex-1 btn-outline">Discard</button>
                   <button type="submit" class="flex-2 btn-primary bg-emerald-500 hover:bg-emerald-600 px-8">Submit to Care Team</button>
               </div>
           </form>
       </div>
   </div>


   <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
       <div>
           <div class="flex items-center gap-3">
               <div class="w-12 h-12 bg-indigo-600 border-2 border-slate-900 flex items-center justify-center font-bold text-white text-2xl rounded-lg shadow-sm">G</div>
               <div>
                   <h1 class="text-3xl font-bold tracking-tight uppercase">Gonio<span class="text-indigo-600">Pro</span> <span class="text-xs border px-2 py-0.5 rounded-full border-slate-900 ml-2 bg-white">HOME CARE V2.6</span></h1>
                   <p class="mono text-[10px] opacity-60 uppercase font-bold tracking-widest">Personal Rehabilitation Suite // Care Link Active</p>
               </div>
           </div>
       </div>
       <div class="flex items-center gap-3">
           <div class="neo-card px-4 py-2 bg-white flex items-center gap-3 h-12">
               <div id="statusDot" class="w-3 h-3 rounded-full bg-slate-300"></div>
               <span id="statusText" class="mono text-xs font-bold uppercase text-slate-500">Idle</span>
           </div>
           <button id="connectBtn" class="btn-primary px-6 h-12 uppercase text-sm">Connect Device</button>
       </div>
   </header>


   <main class="grid grid-cols-1 xl:grid-cols-12 gap-6">
      
       <!-- Left Column -->
       <section class="xl:col-span-8 flex flex-col gap-6">
          
           <div id="visualizer-container" class="rounded-2xl overflow-hidden relative">
               <!-- Calibration Modal Overlay -->
               <div id="calibrationOverlay" class="absolute inset-0 z-50 flex flex-col items-center justify-center text-white hidden bg-slate-900/85 backdrop-blur-sm">
                   <div class="neo-card bg-slate-900 border-indigo-500 p-8 text-center max-w-sm">
                       <h2 class="text-2xl font-bold mb-2 uppercase">Calibration</h2>
                       <p class="text-xs mono opacity-60 mb-6">STAND STILL AND REMAIN AT NEUTRAL</p>
                       <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden border border-slate-700 mb-4">
                           <div id="calibrationProgress" class="h-full bg-indigo-500 transition-all duration-300" style="width: 0%"></div>
                       </div>
                       <p id="calibrationStatus" class="mono text-[10px] font-bold text-indigo-400 animate-pulse">DETECTING SENSOR STABILITY...</p>
                   </div>
               </div>
              
               <!-- HUD Overlays -->
               <div class="absolute top-4 left-4 z-10 flex flex-col gap-2">
                   <div class="neo-card bg-white p-3 min-w-[150px]">
                       <span class="mono text-[10px] block opacity-50 uppercase font-bold mb-1">Target Zone</span>
                       <div class="flex items-baseline gap-2">
                           <span id="goalText" class="text-lg font-bold text-indigo-600">ELBOW_FLEX</span>
                       </div>
                       <div class="mono text-[9px] mt-1 text-slate-500">
                           <span id="targetRangeLow">117</span>° <span class="opacity-40">–</span> <span id="targetRangeHigh">123</span>° <span class="opacity-40">@ <span id="targetDisplayHud">120°</span></span>
                       </div>
                   </div>
                  
                   <div id="holdTimerCard" class="neo-card bg-white p-3 flex flex-col items-center min-w-[150px]">
                       <span class="mono text-[10px] block opacity-50 uppercase font-bold">Hold Duration</span>
                       <span id="holdTimer" class="text-2xl font-black mono text-slate-400 mb-2">0.0s</span>
                       <div class="w-full">
                           <div class="flex justify-between items-center text-[8px] mono font-bold opacity-40 mb-1">
                               <span>PROGRESS</span>
                               <span id="completionLabel">0%</span>
                           </div>
                           <div class="h-2 bg-slate-100 border border-slate-900 rounded-full overflow-hidden">
                               <div id="progressBar" class="h-full bg-indigo-500 transition-all duration-75" style="width: 0%"></div>
                           </div>
                       </div>
                   </div>
               </div>


               <div class="absolute top-4 right-4 z-10 flex flex-col gap-2">
                   <div id="repCard" class="neo-card bg-white p-4 text-center min-w-[110px]">
                       <span class="mono text-[10px] block opacity-50 uppercase font-bold">Reps Done</span>
                       <span class="text-5xl font-bold"><span id="repCount">0</span><span class="text-lg opacity-30">/<span id="targetRepsDisplay">10</span></span></span>
                   </div>
                   <div id="holdStatusBadge" class="neo-card bg-emerald-50 text-emerald-700 p-2 text-center text-[10px] font-bold uppercase hidden">In Hold Zone</div>


                   <div class="neo-card bg-white p-3 min-w-[150px]">
                       <span class="mono text-[10px] block opacity-50 uppercase font-bold mb-2">Precision Tier</span>
                       <div id="tierDisplay" class="flex flex-col gap-1">
                           <div id="tier1Row" class="flex items-center gap-2 opacity-30">
                               <div class="flex gap-0.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="w-2 h-2 rounded-full bg-emerald-500"></span><span class="w-2 h-2 rounded-full bg-emerald-500"></span></div>
                               <span class="mono text-[9px] font-bold uppercase">Precision ±10°</span>
                           </div>
                           <div id="tier2Row" class="flex items-center gap-2 opacity-30">
                               <div class="flex gap-0.5"><span class="w-2 h-2 rounded-full bg-amber-400"></span><span class="w-2 h-2 rounded-full bg-amber-400"></span><span class="w-2 h-2 rounded-full bg-slate-200"></span></div>
                               <span class="mono text-[9px] font-bold uppercase">Good ±20°</span>
                           </div>
                           <div id="tier3Row" class="flex items-center gap-2 opacity-30">
                               <div class="flex gap-0.5"><span class="w-2 h-2 rounded-full bg-orange-400"></span><span class="w-2 h-2 rounded-full bg-slate-200"></span><span class="w-2 h-2 rounded-full bg-slate-200"></span></div>
                               <span class="mono text-[9px] font-bold uppercase">Acceptable ±30°</span>
                           </div>
                           <div id="tierNoneRow" class="flex items-center gap-2">
                               <div class="flex gap-0.5"><span class="w-2 h-2 rounded-full bg-slate-300"></span><span class="w-2 h-2 rounded-full bg-slate-300"></span><span class="w-2 h-2 rounded-full bg-slate-300"></span></div>
                               <span class="mono text-[9px] font-bold uppercase text-slate-400">Not Reached</span>
                           </div>
                       </div>
                   </div>
               </div>


               <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 text-center">
                   <div id="guidanceMsg" class="bg-slate-900 text-white px-6 py-2 rounded-full font-bold text-xs uppercase tracking-tighter opacity-80 shadow-lg">
                       Session Idle
                   </div>
               </div>
           </div>


           <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
               <div class="neo-card p-4">
                   <p class="text-[10px] mono uppercase opacity-40 font-bold mb-1">Live Angle</p>
                   <p id="angleValue" class="text-4xl font-bold">0.0°</p>
               </div>
               <div class="neo-card p-4">
                   <p class="text-[10px] mono uppercase opacity-40 font-bold mb-1">Peak ROM</p>
                   <p id="peakFlex" class="text-4xl font-bold text-indigo-600">0°</p>
               </div>
               <div class="neo-card p-4">
                   <p class="text-[10px] mono uppercase opacity-40 font-bold mb-1">Stability</p>
                   <div class="flex items-baseline gap-1">
                       <p id="stabilityIndex" class="text-4xl font-bold">--</p>
                       <span class="text-xs font-bold opacity-30">%</span>
                   </div>
               </div>
               <div class="neo-card p-4">
                   <p class="text-[10px] mono uppercase opacity-40 font-bold mb-1">Hold Target</p>
                   <p id="avgHoldDisplay" class="text-4xl font-bold">3<span class="text-lg opacity-30 ml-1">sec</span></p>
               </div>
           </div>
       </section>


       <!-- Right Column -->
       <aside class="xl:col-span-4 flex flex-col gap-6">
          
           <div class="neo-card overflow-hidden">
               <div class="flex bg-slate-100 border-b-2 border-slate-900">
                   <button onclick="showTab('rx')" id="tab-rx" class="tab-btn active flex-1 py-3 mono text-[10px] font-bold uppercase border-r-2 border-slate-900">Session</button>
                   <button onclick="showTab('config')" id="tab-config" class="tab-btn flex-1 py-3 mono text-[10px] font-bold uppercase border-r-2 border-slate-900">Config</button>
                   <button onclick="showTab('logs')" id="tab-logs" class="tab-btn flex-1 py-3 mono text-[10px] font-bold uppercase">History</button>
               </div>


               <div class="p-6">
                   <!-- Session Control Center -->
                   <div id="content-rx" class="space-y-6">
                       <div class="flex flex-col gap-3">
                           <button id="sessionToggleBtn" class="btn-primary w-full py-4 uppercase text-sm flex items-center justify-center gap-2">
                               <span id="sessionToggleIcon">▶</span> <span id="sessionToggleText">Start Exercise</span>
                           </button>
                           <button id="restartBtn" class="border-2 border-slate-900 w-full py-2 uppercase text-[10px] font-bold flex items-center justify-center gap-2 hover:bg-slate-100">
                               ↺ Reset Session
                           </button>
                       </div>

                       <div class="pt-4 border-t border-slate-100">
                           <label class="block text-[10px] mono uppercase font-bold mb-3 opacity-50">Prescribed Goals</label>
                           <div class="grid grid-cols-2 gap-2 mb-4">
                               <button onclick="setExercise(120, 'ELBOW_FLEX')" class="border-2 border-slate-900 p-2 text-[10px] font-bold uppercase hover:bg-slate-100">Elbow Flex</button>
                               <button onclick="setExercise(45, 'WRIST_EXT')" class="border-2 border-slate-900 p-2 text-[10px] font-bold uppercase hover:bg-slate-100">Wrist Ext</button>
                               <button onclick="setExercise(90, 'KNEE_FLEX')" class="border-2 border-slate-900 p-2 text-[10px] font-bold uppercase hover:bg-slate-100">Knee Flex</button>
                               <button onclick="setExercise(160, 'SHOULDER')" class="border-2 border-slate-900 p-2 text-[10px] font-bold uppercase hover:bg-slate-100">Shoulder</button>
                           </div>
                          
                           <div class="space-y-4">
                               <div>
                                   <label class="block text-[10px] mono uppercase font-bold mb-1 opacity-50">Target Angle: <span id="sliderVal" class="text-indigo-600">120°</span></label>
                                   <input type="range" id="angleSlider" min="10" max="175" value="120" class="w-full">
                               </div>
                               <div>
                                   <label class="block text-[10px] mono uppercase font-bold mb-3 opacity-50">Hold Time: <span id="holdTargetVal" class="text-indigo-600">3s</span></label>
                                   <input type="range" id="holdSlider" min="0" max="10" value="3" class="w-full">
                               </div>
                           </div>
                       </div>


                       <div class="h-28 w-full pt-4 border-t border-slate-100">
                           <canvas id="historyChart"></canvas>
                       </div>
                   </div>


                   <!-- Config -->
                   <div id="content-config" class="hidden space-y-4">
                       <div>
                           <label class="block text-[10px] mono uppercase font-bold mb-1 opacity-60">Patient Reference ID</label>
                           <input type="text" id="patientId" value="P-7821" class="w-full border-2 border-slate-900 p-2 rounded mono text-sm">
                       </div>
                       <div class="grid grid-cols-2 gap-4">
                           <div>
                               <label class="block text-[10px] mono uppercase font-bold mb-1 opacity-60">Target Reps</label>
                               <input type="number" id="targetReps" value="10" class="w-full border-2 border-slate-900 p-2 rounded mono text-sm">
                           </div>
                           <div>
                               <label class="block text-[10px] mono uppercase font-bold mb-1 opacity-60">Limb</label>
                               <select id="limbSide" class="w-full border-2 border-slate-900 p-2 rounded mono text-sm">
                                   <option>Left</option>
                                   <option>Right</option>
                               </select>
                           </div>
                       </div>
                   </div>


                   <!-- Logs/History -->
                   <div id="content-logs" class="hidden">
                       <div class="bg-black text-emerald-400 p-4 rounded font-mono text-[9px] h-64 overflow-y-auto border-2 border-slate-900 mb-4">
                           <p id="consoleLog">> System Ready</p>
                       </div>
                       <button id="exportBtn" class="w-full border-2 border-slate-900 p-3 text-[10px] font-bold uppercase bg-slate-900 text-white">Save Clinical CSV</button>
                   </div>
               </div>
           </div>


           <div class="neo-card p-4 bg-slate-50 flex justify-between items-center">
               <div class="flex items-center gap-2">
                   <div id="devicePulse" class="w-2 h-2 rounded-full bg-slate-400"></div>
                   <span class="mono text-[8px] font-bold uppercase">Care Link Protocol v2.6</span>
               </div>
               <button onclick="openSurvey()" class="mono text-[8px] font-bold uppercase text-indigo-600 hover:underline">Manual Log Entry</button>
           </div>
       </aside>
   </main>


   <script>
       /** STATE **/
       let sessionStatus = 'IDLE';
       let currentAngle = 0;
       let visualAngle = 0;
       let chartUpdateCounter = 0;
       let targetAngle = 120;
       let holdTimeTarget = 3;
       let isConnected = false;
       let offsetAngle = 0;
       let totalReps = 0;
       let sessionPeak = 0;
       let lastSurveyResults = null;
      
       let lastAngles = [];
       let isMoving = false;
       let repStartTime = 0;
       let repMaxAngle = 0;
       let isHolding = false;
       let holdStartTime = 0;
       let accumulatedHoldMs = 0;
       let currentHoldDuration = 0;
       let holdSatisfied = false;
       let repHistory = [];
       const BLE_SERVICE_UUID = '6f4d0001-7c4d-4b8c-9a7a-3f4c2b6d0001';
       const BLE_DATA_UUID = '6f4d0002-7c4d-4b8c-9a7a-3f4c2b6d0001';
       const BLE_COMMAND_UUID = '6f4d0003-7c4d-4b8c-9a7a-3f4c2b6d0001';
       let bleDevice = null;
       let bleServer = null;
       let bleDataCharacteristic = null;
       let bleCommandCharacteristic = null;
       let bleReceiveBuffer = '';
       let lastDevicePacket = null;
       let deviceCalibrationStep = 0;
       let activeTier = 0;
       let lastTierFeedbackAt = 0;
       let lastHoldChimeSecond = 0;


       let calibrationFrames = 0;
       const CALIBRATION_THRESHOLD = 60;


       /** DRAG STATE **/
       let isDragging = false;
       let handleMesh, handleRing;
       let raycaster3D = new THREE.Raycaster();
       let dragPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
       let handlePulse = 0;


       /** THREE.JS **/
       let scene, camera, renderer, lowerArm, joint, ghostArm;
       const TIER_VISUAL_COLORS = {
           0: { color: 0x94a3b8, emissive: 0x475569 },
           1: { color: 0x10b981, emissive: 0x047857 },
           2: { color: 0xfbbf24, emissive: 0xb45309 },
           3: { color: 0xfb923c, emissive: 0xc2410c }
       };


       function initThree() {
           const container = document.getElementById('visualizer-container');
           scene = new THREE.Scene();
           scene.background = new THREE.Color(0xeef2f7);
           camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 1000);
           camera.position.set(4.5, 2, 5);
           camera.lookAt(0, 0, 0);


           renderer = new THREE.WebGLRenderer({ antialias: true });
           renderer.setSize(container.clientWidth, container.clientHeight);
           container.appendChild(renderer.domElement);


           scene.add(new THREE.AmbientLight(0xffffff, 0.8));
           const dl = new THREE.DirectionalLight(0xffffff, 0.6);
           dl.position.set(5, 5, 5);
           scene.add(dl);


           const boneMat = new THREE.MeshPhongMaterial({ color: 0x0f172a });
           const jointMat = new THREE.MeshPhongMaterial({ color: 0x6366f1 });
           const ghostMat = new THREE.MeshPhongMaterial({ color: 0x6366f1, transparent: true, opacity: 0.08, wireframe: true });


           const upper = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 2.2, 32), boneMat);
           upper.position.y = 1.1;
           scene.add(upper);


           joint = new THREE.Mesh(new THREE.SphereGeometry(0.18, 32, 32), jointMat);
           scene.add(joint);


           lowerArm = new THREE.Group();
           const lMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 2.2, 32), boneMat);
           lMesh.position.y = -1.1;
           lowerArm.add(lMesh);
           scene.add(lowerArm);


           ghostArm = new THREE.Group();
           const gMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 2.2, 32), ghostMat);
           gMesh.position.y = -1.1;
           ghostArm.add(gMesh);
           scene.add(ghostArm);


           const grid = new THREE.GridHelper(10, 20, 0x94a3b8, 0xcbd5e1);
           grid.position.y = -2.5;
           scene.add(grid);


           const handleMat = new THREE.MeshPhongMaterial({ color: 0x6366f1, emissive: 0x4338ca, emissiveIntensity: 0.3 });
           handleMesh = new THREE.Mesh(new THREE.SphereGeometry(0.22, 32, 32), handleMat);
           handleMesh.position.y = -2.2;
           lowerArm.add(handleMesh);


           const ringMat = new THREE.MeshPhongMaterial({ color: 0x6366f1, transparent: true, opacity: 0.35, wireframe: false });
           handleRing = new THREE.Mesh(new THREE.SphereGeometry(0.38, 16, 16), ringMat);
           handleRing.position.y = -2.2;
           lowerArm.add(handleRing);


           renderer.domElement.style.touchAction = 'none';
           renderer.domElement.addEventListener('mousedown', onHandleMouseDown);
           renderer.domElement.addEventListener('mousemove', onHandleHover);
           setEndSphereTierColor(0);
       }


       function setEndSphereTierColor(tier) {
           const tierColor = TIER_VISUAL_COLORS[tier] || TIER_VISUAL_COLORS[0];
           if (handleMesh) {
               handleMesh.material.color.setHex(tierColor.color);
               handleMesh.material.emissive.setHex(tierColor.emissive);
           }
           if (handleRing) {
               handleRing.material.color.setHex(tierColor.color);
           }
       }


       /** DRAG HANDLERS **/
       function getMouseNDC(event) {
           const rect = renderer.domElement.getBoundingClientRect();
           return new THREE.Vector2(
               ((event.clientX - rect.left) / rect.width)  * 2 - 1,
              -((event.clientY - rect.top)  / rect.height) * 2 + 1
           );
       }


       function onHandleMouseDown(event) {
           const ndc = getMouseNDC(event);
           raycaster3D.setFromCamera(ndc, camera);
           const hits = raycaster3D.intersectObject(handleMesh, false);
           if (hits.length === 0) return;
           isDragging = true;
           renderer.domElement.style.cursor = 'grabbing';
           document.addEventListener('mousemove', onDragMove);
           document.addEventListener('mouseup', onDragEnd);
       }


       function onDragMove(event) {
           if (!isDragging) return;
           const ndc = getMouseNDC(event);
           raycaster3D.setFromCamera(ndc, camera);
           const pt = new THREE.Vector3();
           if (!raycaster3D.ray.intersectPlane(dragPlane, pt)) return;
           let deg = THREE.MathUtils.radToDeg(Math.atan2(pt.x, -pt.y));
           processData(Math.max(0, Math.min(175, deg)) + offsetAngle);
       }


       function onDragEnd() {
           isDragging = false;
           renderer.domElement.style.cursor = 'grab';
           document.removeEventListener('mousemove', onDragMove);
           document.removeEventListener('mouseup', onDragEnd);
       }


       function onHandleHover(event) {
           if (isDragging) return;
           const ndc = getMouseNDC(event);
           raycaster3D.setFromCamera(ndc, camera);
           const hits = raycaster3D.intersectObject(handleMesh, false);
           renderer.domElement.style.cursor = hits.length > 0 ? 'grab' : 'default';
       }


       /** SESSION **/
       function toggleSession() {
           if (sessionStatus === 'IDLE') startDeviceCalibration();
           else if (sessionStatus === 'DEVICE_CALIBRATING') captureDeviceCalibrationStep();
           else if (sessionStatus === 'IDLE') startCalibration();
           else stopSession();
       }


       async function startDeviceCalibration() {
           if (!bleCommandCharacteristic) {
               logToConsole("Connect device before starting exercise.");
               document.getElementById('statusText').innerText = 'CONNECT FIRST';
               return;
           }

           sessionStatus = 'DEVICE_CALIBRATING';
           deviceCalibrationStep = 0;
           offsetAngle = 0;
           await sendDeviceCommand('u');
           document.getElementById('calibrationOverlay').classList.remove('hidden');
           document.getElementById('calibrationProgress').style.width = '0%';
           document.getElementById('calibrationStatus').innerText = 'HOLD ARM STRAIGHT DOWN, THEN CAPTURE ZERO';
           document.getElementById('sessionToggleText').innerText = "Capture Zero";
           document.getElementById('sessionToggleBtn').className = "btn-primary w-full py-4 uppercase text-sm flex items-center justify-center gap-2";
           logToConsole("Device calibration started.");
       }


       async function captureDeviceCalibrationStep() {
           if (deviceCalibrationStep === 0) {
               await sendDeviceCommand('n');
               deviceCalibrationStep = 1;
               document.getElementById('calibrationProgress').style.width = '50%';
               document.getElementById('calibrationStatus').innerText = 'BEND ELBOW TO 90 DEGREES, THEN CAPTURE';
               document.getElementById('sessionToggleText').innerText = "Capture 90°";
               logToConsole("Zero pose captured.");
               return;
           }

           await sendDeviceCommand('n');
           deviceCalibrationStep = 2;
           document.getElementById('calibrationProgress').style.width = '100%';
           completeDeviceCalibration();
       }


       function completeDeviceCalibration() {
           sessionStatus = 'ACTIVE';
           offsetAngle = 0;
           resetRepState();
           document.getElementById('calibrationOverlay').classList.add('hidden');
           document.getElementById('sessionToggleText').innerText = "Finish Session";
           document.getElementById('sessionToggleBtn').className = "btn-danger w-full py-4 uppercase text-sm flex items-center justify-center gap-2";
           logToConsole("Device calibration complete. Session active.");
       }


       function startCalibration() {
           sessionStatus = 'CALIBRATING';
           calibrationFrames = 0;
           document.getElementById('calibrationOverlay').classList.remove('hidden');
           document.getElementById('sessionToggleText').innerText = "Abort";
           document.getElementById('sessionToggleBtn').className = "btn-danger w-full py-4 uppercase text-sm flex items-center justify-center gap-2";
       }


       function completeCalibration() {
           sessionStatus = 'ACTIVE';
           document.getElementById('calibrationOverlay').classList.add('hidden');
           document.getElementById('sessionToggleText').innerText = "Finish Session";
           document.getElementById('sessionToggleBtn').className = "btn-danger w-full py-4 uppercase text-sm flex items-center justify-center gap-2";
           offsetAngle = currentAngle;
           resetRepState();
           logToConsole("Session Active.");
       }


       function stopSession() {
           sessionStatus = 'IDLE';
           document.getElementById('sessionToggleText').innerText = "Start Exercise";
           document.getElementById('sessionToggleBtn').className = "btn-primary w-full py-4 uppercase text-sm flex items-center justify-center gap-2";
           logToConsole("Session complete.");
           openSurvey();
       }


       function resetRepState() {
           isMoving = false;
           isHolding = false;
           holdSatisfied = false;
           holdStartTime = 0;
           accumulatedHoldMs = 0;
           currentHoldDuration = 0;
           repStartTime = 0;
           repMaxAngle = 0;
           activeTier = 0;
           lastHoldChimeSecond = 0;
           document.getElementById('holdTimer').innerText = "0.0s";
           document.getElementById('holdTimerCard').classList.remove('hold-active');
           document.getElementById('holdStatusBadge').classList.add('hidden');
           updateTierDisplay(0);
       }


       /** SURVEY **/
       function openSurvey() {
           document.getElementById('finalRepCount').innerText = `REPS: ${totalReps}`;
           document.getElementById('surveyModal').classList.remove('hidden');
           document.getElementById('surveyModal').classList.add('flex');
           setTimeout(() => document.getElementById('surveyModal').classList.add('active'), 10);
       }


       function closeSurvey() {
           document.getElementById('surveyModal').classList.remove('active');
           setTimeout(() => {
               document.getElementById('surveyModal').classList.add('hidden');
               document.getElementById('surveyModal').classList.remove('flex');
           }, 300);
       }


       document.getElementById('sessionSurveyForm').onsubmit = (e) => {
           e.preventDefault();
           const labels=['Stiff','Moderate','Fluid'];
           lastSurveyResults = {
               pain: document.getElementById('surveyPain').value,
               ease: labels[document.getElementById('surveyEase').value - 1],
               setup: document.getElementById('surveySetup').value,
               confidence: document.getElementById('surveyConfidence').value,
               comments: document.getElementById('surveyComments').value
           };
           logToConsole("Home assessment documented.");
           exportReport();
           closeSurvey();
       };


       /** ANALYTICS **/
       function holdChimeCommandForSecond(completedSecond) {
           if (holdTimeTarget <= 0) return 'z';

           const targetSeconds = Math.max(1, Math.ceil(holdTimeTarget));
           const progress = targetSeconds === 1
               ? 1
               : (completedSecond - 1) / (targetSeconds - 1);
           const chimeCommands = ['c', 'd', 'e', 'f', 'z'];
           const index = Math.min(
               chimeCommands.length - 1,
               Math.max(0, Math.round(progress * (chimeCommands.length - 1)))
           );
           return chimeCommands[index];
       }


       function processData(val) {
           currentAngle = Math.abs(parseFloat(val) - offsetAngle);
           lastAngles.push(currentAngle);
           if (lastAngles.length > 20) lastAngles.shift();


           if (sessionStatus === 'CALIBRATING') {
               calibrationFrames++;
               const progress = (calibrationFrames / CALIBRATION_THRESHOLD) * 100;
               document.getElementById('calibrationProgress').style.width = progress + "%";
               if (calibrationFrames >= CALIBRATION_THRESHOLD) completeCalibration();
               return;
           }

           if (sessionStatus === 'DEVICE_CALIBRATING') {
               document.getElementById('angleValue').innerText = currentAngle.toFixed(1) + "°";
               return;
           }


           if (sessionStatus !== 'ACTIVE') {
               document.getElementById('angleValue').innerText = currentAngle.toFixed(1) + "°";
               return;
           }


           // Rep Detection
           if (!isMoving && currentAngle > 6) {
               isMoving = true;
               repStartTime = Date.now();
               repMaxAngle = 0;
               holdSatisfied = false;
               accumulatedHoldMs = 0;
               currentHoldDuration = 0;
               lastHoldChimeSecond = 0;
           }


           if (isMoving) {
               if (currentAngle > repMaxAngle) repMaxAngle = currentAngle;
               const diff = Math.abs(currentAngle - targetAngle);
               const inZone = diff <= 10;
              
               updateTierDisplay(diff <= 10 ? 1 : diff <= 20 ? 2 : diff <= 30 ? 3 : 0);


               if (inZone && !isHolding) {
                   isHolding = true; holdStartTime = Date.now();
                   document.getElementById('holdTimerCard').classList.add('hold-active');
                   document.getElementById('holdStatusBadge').classList.remove('hidden');
               } else if (!inZone && isHolding) {
                   accumulatedHoldMs += Date.now() - holdStartTime;
                   isHolding = false;
                   holdStartTime = 0;
                   currentHoldDuration = accumulatedHoldMs / 1000;
                   document.getElementById('holdTimer').innerText = currentHoldDuration.toFixed(1) + "s";
                   document.getElementById('holdTimerCard').classList.remove('hold-active');
                   document.getElementById('holdStatusBadge').classList.add('hidden');
                   if (!holdSatisfied && accumulatedHoldMs > 0) {
                       document.getElementById('guidanceMsg').innerText = "Hold paused. Return to target zone.";
                   }
               }


               if (isHolding) {
                   currentHoldDuration = (accumulatedHoldMs + (Date.now() - holdStartTime)) / 1000;
                   document.getElementById('holdTimer').innerText = currentHoldDuration.toFixed(1) + "s";
                   const completedHoldSecond = Math.floor(currentHoldDuration);
                   if (!holdSatisfied && completedHoldSecond > lastHoldChimeSecond) {
                       lastHoldChimeSecond = completedHoldSecond;
                       sendDeviceCommand(holdChimeCommandForSecond(completedHoldSecond));
                   }
                   if (!holdSatisfied && currentHoldDuration >= holdTimeTarget) {
                       holdSatisfied = true;
                       document.getElementById('guidanceMsg').innerText = "Hold complete. Return to start.";
                       logToConsole("Hold complete. Return to start to count rep.");
                   }
               }


               if (holdSatisfied && currentAngle < 4 && (Date.now() - repStartTime) > 1500) {
                   finalizeRep();
               }
           }


           if (currentAngle > sessionPeak) {
               sessionPeak = Math.round(currentAngle);
               document.getElementById('peakFlex').innerText = sessionPeak + "°";
           }


           document.getElementById('angleValue').innerText = currentAngle.toFixed(1) + "°";
           let progressPct = Math.min(100, (currentAngle / targetAngle) * 100);
           document.getElementById('progressBar').style.width = progressPct + "%";
           document.getElementById('completionLabel').innerText = Math.round(progressPct) + "%";
           updateChart(currentAngle);
       }


       function finalizeRep() {
           isMoving = false; isHolding = false;
           totalReps++;
           repHistory.push({
               repNum: totalReps,
               maxAngle: repMaxAngle.toFixed(1),
               holdTime: currentHoldDuration.toFixed(1),
               timestamp: new Date().toLocaleTimeString()
           });
           document.getElementById('repCount').innerText = totalReps;
           flashRepCounter();
           const sessionComplete = totalReps >= getTargetReps();
           sendDeviceCommand(sessionComplete ? 'w' : 'b');
           document.getElementById('holdTimer').innerText = "0.0s";
           document.getElementById('holdTimerCard').classList.remove('hold-active');
           document.getElementById('holdStatusBadge').classList.add('hidden');
           document.getElementById('guidanceMsg').innerText = "Good rep. Begin next rep.";
           logToConsole(`Rep ${totalReps} logged.`);
           accumulatedHoldMs = 0;
           currentHoldDuration = 0;
           holdSatisfied = false;
           activeTier = 0;
           lastHoldChimeSecond = 0;

           if (sessionComplete) {
               sessionStatus = 'ENDING';
               document.getElementById('guidanceMsg').innerText = "Target reps complete.";
               logToConsole("Target reps complete. Ending session.");
               setTimeout(() => stopSession(), 2400);
           }
       }


       function getTargetReps() {
           return Math.max(1, parseInt(document.getElementById('targetReps').value || '1', 10));
       }


       function flashRepCounter() {
           const card = document.getElementById('repCard');
           card.classList.remove('rep-flash');
           void card.offsetWidth;
           card.classList.add('rep-flash');
       }


       function updateTierDisplay(tier) {
           ['tier1Row','tier2Row','tier3Row','tierNoneRow'].forEach(id => document.getElementById(id).classList.add('opacity-30'));
           const map = {1:'tier1Row', 2:'tier2Row', 3:'tier3Row', 0:'tierNoneRow'};
           document.getElementById(map[tier]).classList.remove('opacity-30');
           setEndSphereTierColor(tier);

           const now = Date.now();
           if (tier !== activeTier && tier > 0 && now - lastTierFeedbackAt > 900) {
               activeTier = tier;
               lastTierFeedbackAt = now;
               sendDeviceCommand(String(tier));
           } else if (tier === 0) {
               activeTier = 0;
           }
       }


       function logToConsole(msg) {
           const logEl = document.getElementById('consoleLog');
           const p = document.createElement('p');
           p.innerText = `> ${msg}`;
           logEl.prepend(p);
       }


       function exportReport() {
           if (repHistory.length === 0) return;
           let csv = "GonioPro Home Care Report\nPatient," + document.getElementById('patientId').value + "\n\n";
           if (lastSurveyResults) {
               csv += "SURVEY RESULTS\nPain," + lastSurveyResults.pain + "/10\nMobility," + lastSurveyResults.ease + "\nSetup," + lastSurveyResults.setup + "\nConfidence," + lastSurveyResults.confidence + "\nNotes," + lastSurveyResults.comments + "\n\n";
           }
           csv += "Rep,Time,Max Angle,Hold Time\n";
           repHistory.forEach(r => csv += `${r.repNum},${r.timestamp},${r.maxAngle},${r.holdTime}\n`);
           const blob = new Blob([csv], { type: 'text/csv' });
           const url = window.URL.createObjectURL(blob);
           const a = document.createElement('a');
           a.href = url;
           a.download = `Home_Rehab_Log_${Date.now()}.csv`;
           a.click();
       }


       /** CHART **/
       let chart;
       function initChart() {
           const ctx = document.getElementById('historyChart').getContext('2d');
           chart = new Chart(ctx, {
               type: 'line',
               data: { labels: Array(40).fill(''), datasets: [{ data: Array(40).fill(0), borderColor: '#6366f1', borderWidth: 2, pointRadius: 0, fill: true, backgroundColor: 'rgba(99, 102, 241, 0.05)', tension: 0.4 }] },
               options: { responsive: true, maintainAspectRatio: false, animation: false, scales: { y: { min: 0, max: 180, ticks: { display: false }, grid: { display: false } }, x: { display: false } }, plugins: { legend: { display: false } } }
           });
       }
       function updateChart(v) {
           chartUpdateCounter++;
           if (chartUpdateCounter % 3 !== 0) return;

           chart.data.datasets[0].data.push(v);
           chart.data.datasets[0].data.shift();
           chart.update('none');
       }


       function showTab(tab) {
           document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
           document.getElementById(`tab-${tab}`).classList.add('active');
           ['rx', 'config', 'logs'].forEach(t => document.getElementById(`content-${t}`).classList.add('hidden'));
           document.getElementById(`content-${tab}`).classList.remove('hidden');
       }


       function setExercise(angle, name) {
           targetAngle = angle;
           document.getElementById('goalText').innerText = name;
           document.getElementById('angleSlider').value = angle;
           document.getElementById('sliderVal').innerText = angle + "°";
           document.getElementById('targetDisplayHud').innerText = angle + "°";
           logToConsole(`Goal: ${name}`);
       }


       function syncTargetReps() {
           const input = document.getElementById('targetReps');
           const value = Math.max(1, parseInt(input.value || '1', 10));
           input.value = value;
           document.getElementById('targetRepsDisplay').innerText = value;
       }


       function parseKeyValuePacket(line) {
           const parts = line.trim().split(',');
           const packet = { type: parts.shift() };
           parts.forEach(part => {
               const idx = part.indexOf('=');
               if (idx === -1) return;
               const key = part.slice(0, idx).trim();
               const raw = part.slice(idx + 1).trim();
               const numeric = Number(raw);
               packet[key] = Number.isNaN(numeric) ? raw : numeric;
           });
           return packet;
       }


       function applyDevicePacket(packet) {
           if (packet.type !== 'DATA') return;
           lastDevicePacket = packet;
           isConnected = packet.forearm_ready === 1 && packet.bicep_ready === 1;

           document.getElementById('statusDot').className = 'w-3 h-3 rounded-full ' + (isConnected ? 'bg-emerald-500' : 'bg-amber-500');
           document.getElementById('statusText').innerText = isConnected ? (packet.calibrated ? 'DEVICE LIVE' : 'UNCALIBRATED') : 'CHECK IMUS';
           document.getElementById('connectBtn').innerText = isConnected ? 'BLE Live' : 'BLE Connected';

           if (typeof packet.angle === 'number') {
               processData(packet.angle);
           }
       }


       async function sendDeviceCommand(command) {
           if (!bleCommandCharacteristic) {
               logToConsole("Device command ignored: not connected.");
               return;
           }

           const payload = new TextEncoder().encode(command);
           if (bleCommandCharacteristic.writeValueWithoutResponse) {
               await bleCommandCharacteristic.writeValueWithoutResponse(payload);
           } else {
               await bleCommandCharacteristic.writeValue(payload);
           }
       }


       function handleBleDataNotification(event) {
           const decoder = new TextDecoder();
           bleReceiveBuffer += decoder.decode(event.target.value);
           const lines = bleReceiveBuffer.split(/\r?\n/);
           bleReceiveBuffer = lines.pop() || '';
           lines.forEach(line => {
               const trimmed = line.trim();
               if (!trimmed) return;
               if (trimmed.startsWith('DATA,')) {
                   applyDevicePacket(parseKeyValuePacket(trimmed));
               }
           });
       }


       function handleBleDisconnect() {
           bleServer = null;
           bleDataCharacteristic = null;
           bleCommandCharacteristic = null;
           isConnected = false;
           document.getElementById('statusDot').className = 'w-3 h-3 rounded-full bg-slate-400';
           document.getElementById('statusText').innerText = 'BLE DISCONNECTED';
           document.getElementById('connectBtn').innerText = 'Connect Device';
           logToConsole("BLE device disconnected.");
       }


       async function connectBleDevice() {
           try {
               if (!navigator.bluetooth) {
                   logToConsole("Web Bluetooth requires Chrome or Edge on localhost/HTTPS.");
                   document.getElementById('statusText').innerText = 'WEB BLE N/A';
                   return;
               }

               bleDevice = await navigator.bluetooth.requestDevice({
                   filters: [{ namePrefix: 'GonioPro' }],
                   optionalServices: [BLE_SERVICE_UUID]
               });
               bleDevice.addEventListener('gattserverdisconnected', handleBleDisconnect);

               bleServer = await bleDevice.gatt.connect();
               const service = await bleServer.getPrimaryService(BLE_SERVICE_UUID);
               bleDataCharacteristic = await service.getCharacteristic(BLE_DATA_UUID);
               bleCommandCharacteristic = await service.getCharacteristic(BLE_COMMAND_UUID);
               await bleDataCharacteristic.startNotifications();
               bleDataCharacteristic.addEventListener('characteristicvaluechanged', handleBleDataNotification);

               document.getElementById('statusDot').className = 'w-3 h-3 rounded-full bg-emerald-500';
               document.getElementById('statusText').innerText = 'BLE OPEN';
               document.getElementById('connectBtn').innerText = 'BLE Connected';
               logToConsole("BLE device connected.");
           } catch (err) {
               document.getElementById('statusDot').className = 'w-3 h-3 rounded-full bg-red-500';
               document.getElementById('statusText').innerText = 'CONNECT FAIL';
               logToConsole(`Connect failed: ${err.message}`);
           }
       }


       function animate() {
           requestAnimationFrame(animate);
           visualAngle += (currentAngle - visualAngle) * 0.25;
           lowerArm.rotation.z = THREE.MathUtils.degToRad(visualAngle);
           ghostArm.rotation.z = THREE.MathUtils.degToRad(targetAngle);
           if (handleRing) {
               handlePulse += 0.05;
               handleRing.scale.setScalar(1 + 0.1 * Math.sin(handlePulse));
           }
           renderer.render(scene, camera);
       }


       window.onload = () => {
           initThree(); initChart(); animate();
           document.getElementById('sessionToggleBtn').onclick = toggleSession;
           document.getElementById('connectBtn').onclick = connectBleDevice;
           document.getElementById('exportBtn').onclick = exportReport;
           document.getElementById('restartBtn').onclick = () => window.location.reload();
           document.getElementById('angleSlider').oninput = (e) => {
               targetAngle = parseInt(e.target.value);
               document.getElementById('sliderVal').innerText = targetAngle + "°";
               document.getElementById('targetDisplayHud').innerText = targetAngle + "°";
           };
           document.getElementById('holdSlider').oninput = (e) => {
               holdTimeTarget = parseInt(e.target.value);
               document.getElementById('holdTargetVal').innerText = holdTimeTarget + "s";
               document.getElementById('avgHoldDisplay').innerHTML = holdTimeTarget + '<span class="text-lg opacity-30 ml-1">sec</span>';
           };
           document.getElementById('targetReps').oninput = syncTargetReps;
           syncTargetReps();
       };
   </script>
